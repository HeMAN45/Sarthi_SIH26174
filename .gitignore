__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Runtime data — sessions are large; keep tagged fixtures only
data/
!data/.gitkeep

# Models are bundled at package time, never committed.
# Weights (yolo11n.pt, yolov8s-worldv2.pt, yolo11n-cls.pt, trained best.pt) are
# downloaded/produced on first run -- never commit them.
*.pt
*.onnx
*.engine
runs/

# Deck build workspace: keep the generator scripts, not its dependencies
_ppt_build/node_modules/

# Datasets and renders live outside the repo (150 GB budget, see TRD 1.1)
datasets/
renders/

node_modules/
ui/dist/
.env
.DS_Store
Thumbs.db

# Piper voice models — 60 MB+ binaries, fetched at setup time:
#   uv run python -m piper.download_voices en_US-lessac-medium --data-dir models/voices
models/voices/
# Pre-synthesized prompt cache, rebuilt on demand from the voice model.
data/voice/
